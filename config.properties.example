# ============================================================
# WaryCode Agent 配置模板
# 复制为 config.properties 后手动填写（config.properties 不进 git）
# ============================================================

# API Key（必填）
api.key=sk-xxxx

# API 端点：留空使用 OpenAI 官方；
# 可指向 OpenAI 兼容端点，如 DeepSeek / GLM / Ollama
base.url=https://api.openai.com/v1

# 模型名（默认 gpt-5.5，按所用端点支持的模型填写）
model=gpt-5.5

# 工作目录：文件工具的沙箱根，留空 = 程序启动目录
workspace=
